NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disaster_response
DB_USER=disaster_response
DB_PASSWORD=replace-with-a-dedicated-password
JWT_SECRET=replace-with-at-least-32-random-characters
ENABLE_LEGACY_EMERGENCY_SURFACES=false
# Provider adapters are disabled until explicitly configured and accredited.
GIS_PROVIDER_URL=
WEATHER_PROVIDER_URL=
ALERT_PROVIDER_URL=
MESSAGING_PROVIDER_URL=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
